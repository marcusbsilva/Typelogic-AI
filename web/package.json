{
  "name": "typelogic-web",
  "private": true,
  "version": "1.1.0",
  "description": "TypeScript sources of the TypeLogic AI local interface (compiled to typelogic/web/app.js)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && esbuild src/app.ts --bundle --format=iife --target=es2020 --charset=utf8 --legal-comments=none --outfile=../typelogic/web/app.js",
    "test:ui": "node tests/ui.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0"
  }
}
